# Banco (dev local). Não versionar o .env real.
DATABASE_URL="mysql://USUARIO:SENHA@127.0.0.1:3306/expagrolab_dev"

PORT=3001

# E-mail (espelha o SAGRE: blastula → nodemailer)
EMAIL_ENABLED=true
SIMULATE_SEND=true                 # true = renderiza HTML em arquivo, não envia (default seguro)
SIMULATE_OUTPUT_DIR=./email-previews
EMAIL_BASE_URL="http://localhost:3000"
# --- SMTP real (usado quando SIMULATE_SEND=false; se SMTP_HOST faltar, cai para SIMULATE) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587                      # 465 = TLS implícito (secure); 587/25 = STARTTLS
SMTP_SECURE=""                     # opcional: força true/false (default: true só na 465)
SMTP_USER="notification@exemplo.com"  # cai para EMAIL_USER se ausente
SMTP_PASSWORD=""                   # app password (só quando SIMULATE_SEND=false)
EMAIL_FROM="EXP-AGROLAB <notification@exemplo.com>"  # remetente; cai para SMTP_USER/EMAIL_USER
EMAIL_USER="notification@exemplo.com"  # legado (compat): usado como user/from se os acima faltarem

# Storage de arquivos (fotos de parcela / anexos) — S3-compatível (MinIO em dev).
# Se S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY faltarem, cai para storage LOCAL (fallback dev):
# grava em UPLOAD_DIR e serve por GET /uploads/* (usando API_PUBLIC_BASE na URL).
S3_ENDPOINT=""                     # ex.: http://localhost:9000 (MinIO); vazio = fallback local
S3_PUBLIC_BASE=""                  # base pública da URL do objeto (default: S3_ENDPOINT)
S3_BUCKET="expagrolab"
S3_ACCESS_KEY=""                   # ex.: minioadmin
S3_SECRET_KEY=""                   # ex.: minioadmin
S3_REGION="us-east-1"
UPLOAD_DIR=""                      # fallback local: pasta dos arquivos (default: apps/api/uploads)
API_PUBLIC_BASE="http://localhost:3001"  # fallback local: base da URL /uploads/*

# Auth
JWT_SECRET="dev-secret-troque-em-producao"
JWT_EXPIRES="15m"                  # access token curto quando há refresh (ver JWT_REFRESH_EXPIRES)
JWT_REFRESH_EXPIRES="30d"          # validade do refresh-token
PASSWORD_MIN_LENGTH=8              # política de senha forte (mín. de caracteres)
